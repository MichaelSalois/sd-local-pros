# ============================================================
# SD LOCAL PROS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values

# Zapier Webhook URL — triggers email + SMS alerts when someone
# submits a new business or claims a listing.
# Set up a "Webhooks by Zapier" trigger in Zapier, then paste the URL here.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# Supabase (for future database integration)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics (add your GA4 measurement ID)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
